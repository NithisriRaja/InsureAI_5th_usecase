# --- Storage: one CSV file per table. Default: backend/data ---
# DATA_DIR=backend/data

# Freeze "today" for reproducible demos/tests (YYYY-MM-DD). Empty = real date.
AS_OF_DATE=

# --- LLM provider: domo | anthropic ---
LLM_PROVIDER=domo
# json_schema | json_object | prompt  (free models: prompt or json_object is safest)
LLM_STRUCTURED_MODE=prompt
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=60
LLM_MAX_ATTEMPTS=5
LLM_MAX_TOTAL_WAIT_S=120
# Global rate limit (requests per minute) and max concurrent LLM calls
LLM_RPM=15
LLM_MAX_CONCURRENCY=2
LLM_MAX_TOKENS=4096
LLM_RETRY_BASE_S=1
LLM_RETRY_CAP_S=30

# Domo AI Services (text generation). Domo has no native JSON-schema mode: keep LLM_STRUCTURED_MODE=prompt
DOMO_API_KEY=
DOMO_BASE_URL=https://<instance>.domo.com/api
DOMO_MODEL=domo.openai.gpt-5.5

# Anthropic (structured outputs via output_config.format; use LLM_STRUCTURED_MODE=json_schema)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_FALLBACKS=true

# --- Runner ---
RUNNER_WORKERS=2
RUNNER_POLL_INTERVAL_S=0.5
RUN_HEARTBEAT_S=5
RUN_STALE_AFTER_S=60
RUN_MAX_ATTEMPTS=3

# --- Business ---
# Thresholds, products and lifecycle windows live in backend/rulebook.py.
CURRENCY=AED
# Optional override of the one-year expiry notice window (default: rulebook, 45 days).
RENEWAL_WINDOW_DAYS=

# --- Sessions / API ---
SESSION_IDLE_HOURS=12
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Customer portal: base of the renew / pay / upload / review links in messages ---
# CUSTOMER_PORTAL_URL=https://portal.example.com
